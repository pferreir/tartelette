# Raspberry Pi Pico W on a Pimoroni Pico Display Pack 2.0: a 2.0" 320x240
# ST7789 on SPI0 (chip select, D/C and backlight are plain GPIOs) and four
# buttons A/B/X/Y to GND. The Wi-Fi chip is wired as in pico-w.board; the
# board's green LED lives on the Wi-Fi chip, not on a GPIO.
board Pico-W-Display

cyw43439 wifi on=23 dio=24 cs=25 clk=29 mac=28:cd:c1:00:00:01 ap1=TarteletteNet,wpa2,hunter22,-45,6 ap2=FreeCafe,open,-70,11

spi0 sck=18 mosi=19
st7789 screen bus=spi0 cs=9 dc=13 bl=17

button a gpio=12
button b gpio=20
button x gpio=14
button y gpio=15

panel screen at=0,0 span=6,4 rotate=270
panel wifi   at=6,0 span=2,2 label=Wi-Fi
panel a      at=0,4 label=A key=A
panel b      at=1,4 label=B key=B
panel x      at=2,4 label=X key=X
panel y      at=3,4 label=Y key=Y
