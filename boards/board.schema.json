{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tartelette board",
  "description": "A PCB around the chip: buses, the parts on them and a front panel layout. Generated by `tartelette schema`.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "the board's (or shield's) name"
    },
    "buses": {
      "type": "object",
      "description": "the chip's bus controllers wired on this board, and their pins",
      "properties": {
        "i2c0": {
          "type": "object",
          "properties": {
            "sda": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "scl": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            }
          },
          "additionalProperties": false
        },
        "i2c1": {
          "type": "object",
          "properties": {
            "sda": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "scl": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            }
          },
          "additionalProperties": false
        },
        "spi0": {
          "type": "object",
          "properties": {
            "sck": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "mosi": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "miso": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            }
          },
          "additionalProperties": false
        },
        "spi1": {
          "type": "object",
          "properties": {
            "sck": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "mosi": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            },
            "miso": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29,
              "description": "GPIO"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "object",
      "description": "the devices on the board, by name",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["led", "button", "mcp23008", "st7789", "ws2812", "dac8165", "encoder", "ps2mouse", "pot", "wav", "speaker", "midi", "pcm5102", "ssd1306", "sdcard", "cyw43439"],
            "description": "what the part is:\n- led: LED on a pin\n- button: momentary switch to GND or 3V3\n- mcp23008: 8-bit I2C port expander with interrupt output\n- st7789: SPI TFT display controller with frame RAM\n- ws2812: WS2812 / SK6812 LED chain decoded from the data line\n- dac8165: quad 14-bit DAC on a bit-banged serial link\n- encoder: rotary encoder (quadrature contacts)\n- ps2mouse: PS/2 mouse on clock and data lines\n- pot: potentiometer: a voltage between GND and 3V3 for the ADC\n- wav: WAV file player: an audio signal on a pin for the ADC\n- speaker: speaker playing a DAC output or a GPIO's PWM as sound\n- midi: MIDI in jack: host MIDI on a UART's RX or as serial on a pin\n- pcm5102: PCM5102A stereo I2S audio DAC\n- ssd1306: SSD1306 monochrome OLED controller on I2C\n- sdcard: SDHC card in SPI mode over a disk image\n- cyw43439: Pico W Wi-Fi/Bluetooth chip on a bit-banged gSPI link"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "led"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "led",
                  "description": "LED on a pin"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin it hangs off (other parts may use this GPIO too)"
                },
                "active": {
                  "enum": ["high", "low"],
                  "description": "the level that lights it (default \"high\")"
                }
              },
              "required": ["gpio"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "button"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "button",
                  "description": "momentary switch to GND or 3V3"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin the switch pulls"
                },
                "active": {
                  "enum": ["high", "low"],
                  "description": "the level it pulls the pin to when pressed (default \"low\")"
                }
              },
              "required": ["gpio"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "mcp23008"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "mcp23008",
                  "description": "8-bit I2C port expander with interrupt output"
                },
                "bus": {
                  "enum": ["i2c0", "i2c1"],
                  "description": "the bus it sits on (declared under [buses])"
                },
                "addr": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 39,
                  "description": "I2C address (A2..A0 pins) (default 0x20)"
                },
                "int": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the GPIO its INT output drives (open drain can be shared) (other parts may use this GPIO too)"
                },
                "pins": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pin": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 7,
                        "description": "which pin, GP0..GP7"
                      },
                      "as": {
                        "enum": ["switch", "toggle", "led"],
                        "description": "what is wired to it: a momentary switch, a latching one, or an LED"
                      },
                      "name": {
                        "type": "string",
                        "description": "a name for it: an action for its switch, an event for its LED or switch"
                      },
                      "contact": {
                        "enum": ["no", "nc"],
                        "description": "switch: normally open (closes when actuated) or normally closed (default no)"
                      },
                      "to": {
                        "enum": ["gnd", "vcc"],
                        "description": "switch: what the closed contact connects the pin to (default gnd)"
                      },
                      "bounce_us": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000,
                        "description": "switch: how long the contact chatters after it moves (default 0)"
                      },
                      "initial": {
                        "enum": ["off", "on"],
                        "description": "toggle: its position at power-on (default off)"
                      },
                      "lit": {
                        "enum": ["high", "low"],
                        "description": "led: the level that lights it; low for an LED from VCC sunk by the pin (default high)"
                      },
                      "pull": {
                        "enum": ["up", "down"],
                        "description": "an external pull resistor on the pin"
                      }
                    },
                    "required": ["pin"],
                    "additionalProperties": false
                  },
                  "description": "what is wired to each pin"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn bounce_us into cycles (default: the chip's clk_sys)"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "st7789"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "st7789",
                  "description": "SPI TFT display controller with frame RAM"
                },
                "bus": {
                  "enum": ["spi0", "spi1"],
                  "description": "the bus it sits on (declared under [buses])"
                },
                "cs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "chip select, active low (none: always selected)"
                },
                "dc": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "data/command select"
                },
                "rst": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "reset, active low"
                },
                "bl": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "backlight enable"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 480,
                  "description": "panel width in pixels, in its native orientation (default 240)"
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 480,
                  "description": "panel height in pixels (default 320)"
                }
              },
              "required": ["dc"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ws2812"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ws2812",
                  "description": "WS2812 / SK6812 LED chain decoded from the data line"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the data line"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096,
                  "description": "LEDs in the chain (default 8)"
                },
                "order": {
                  "enum": ["grb", "rgb"],
                  "description": "colour order on the wire (default \"grb\")"
                },
                "reset_us": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "description": "low time that latches the colours, in microseconds (default 50)"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn time into cycles (default: the chip's clk_sys)"
                }
              },
              "required": ["gpio"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "dac8165"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dac8165",
                  "description": "quad 14-bit DAC on a bit-banged serial link"
                },
                "sdi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "serial data in"
                },
                "cs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "sync (chip select), active low"
                },
                "clk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "serial clock"
                },
                "rst": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "reset, active low"
                },
                "vref_mv": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "description": "reference voltage in millivolts: the full-scale output (default 2500)"
                },
                "cv_zero_uv": {
                  "type": "integer",
                  "minimum": -10000000,
                  "maximum": 10000000,
                  "description": "output stage: the DAC output (microvolts) that gives 0 V at the jack (default 0)"
                },
                "cv_uv_per_volt": {
                  "type": "integer",
                  "minimum": -10000000,
                  "maximum": 10000000,
                  "description": "output stage: DAC microvolts per volt at the jack, negative if it inverts (default 1000000)"
                }
              },
              "required": ["sdi", "cs", "clk"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "encoder"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "encoder",
                  "description": "rotary encoder (quadrature contacts)"
                },
                "clk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "contact A"
                },
                "dt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "contact B"
                },
                "cw": {
                  "enum": ["clk", "dt"],
                  "description": "the contact that leads when turning clockwise (default \"clk\")"
                },
                "step_us": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000,
                  "description": "time between transitions, in microseconds (default 300)"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn time into cycles (default: the chip's clk_sys)"
                }
              },
              "required": ["clk", "dt"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ps2mouse"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ps2mouse",
                  "description": "PS/2 mouse on clock and data lines"
                },
                "clk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the clock line"
                },
                "data": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the data line"
                },
                "model": {
                  "enum": ["basic", "wheel", "explorer"],
                  "description": "three buttons; a wheel (IntelliMouse); a wheel and five buttons (Explorer) (default \"wheel\")"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn time into cycles (default: the chip's clk_sys)"
                }
              },
              "required": ["clk", "data"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pot"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "pot",
                  "description": "potentiometer: a voltage between GND and 3V3 for the ADC"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin the wiper is on (GPIO26 to 29 reach the ADC)"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "description": "the wiper's starting position, in per mille of the travel (default 500)"
                }
              },
              "required": ["gpio"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "wav"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "wav",
                  "description": "WAV file player: an audio signal on a pin for the ADC"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin the signal is on (GPIO26 to 29 reach the ADC)"
                },
                "file": {
                  "type": "string",
                  "description": "the WAV file to load, relative to the board file (the front panel can load one too)"
                },
                "bias": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3300,
                  "description": "the level of silence, in millivolts (default 1650)"
                },
                "gain": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000,
                  "description": "how far a full-scale sample swings from bias, in millivolts (default 1650)"
                },
                "channel": {
                  "enum": ["left", "right", "mix"],
                  "description": "the channel of a stereo file to play (default \"mix\")"
                },
                "loop": {
                  "enum": ["off", "on"],
                  "description": "start over at the end (default \"off\")"
                },
                "autoplay": {
                  "enum": ["off", "on"],
                  "description": "play from power-up, and each file as it is loaded (default \"off\")"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn time into cycles (default: the chip's clk_sys)"
                }
              },
              "required": ["gpio"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "speaker"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "speaker",
                  "description": "speaker playing a DAC output or a GPIO's PWM as sound"
                },
                "dac": {
                  "type": "string",
                  "description": "the DAC it plays: a dac8165 channel (dac.A) or a pcm5102 (pcm, pcm.L, pcm.R); or gpio"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin it plays, as PWM or PDM; or dac (other parts may use this GPIO too)"
                },
                "volume": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "the starting volume, in percent (default 100)"
                },
                "rate": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 192000,
                  "description": "on a gpio: how often the pin's average level is taken, in Hz (default 48000)"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "on a gpio: core clock, to turn time into cycles (default: the chip's clk_sys)"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "midi"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "midi",
                  "description": "MIDI in jack: host MIDI on a UART's RX or as serial on a pin"
                },
                "uart": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "the UART whose RX the jack feeds; or gpio"
                },
                "gpio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "the pin the jack feeds, as 31250-baud serial; or uart"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "on a gpio: core clock, to time the bits (default: the chip's clk_sys)"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pcm5102"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "pcm5102",
                  "description": "PCM5102A stereo I2S audio DAC"
                },
                "bck": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "bit clock"
                },
                "lrck": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "word clock (LRCK, WS): low for the left channel"
                },
                "din": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "serial data"
                }
              },
              "required": ["bck", "lrck", "din"],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ssd1306"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ssd1306",
                  "description": "SSD1306 monochrome OLED controller on I2C"
                },
                "bus": {
                  "enum": ["i2c0", "i2c1"],
                  "description": "the bus it sits on (declared under [buses])"
                },
                "addr": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 61,
                  "description": "I2C address (SA0 low: 0x3C) (default 0x3c)"
                },
                "height": {
                  "enum": ["32", "64"],
                  "description": "rows of the panel (128 wide) (default \"64\")"
                },
                "color": {
                  "enum": ["white", "blue", "yellow", "green"],
                  "description": "the colour the pixels glow (default \"white\")"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sdcard"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "sdcard",
                  "description": "SDHC card in SPI mode over a disk image"
                },
                "bus": {
                  "enum": ["spi0", "spi1"],
                  "description": "the bus it sits on (declared under [buses])"
                },
                "cs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "chip select, active low (none: always selected)"
                },
                "size_mb": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2048,
                  "description": "start with a blank card of this many MiB (none: an empty slot until an image is loaded)"
                }
              },
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "cyw43439"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "cyw43439",
                  "description": "Pico W Wi-Fi/Bluetooth chip on a bit-banged gSPI link"
                },
                "on": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "WL_ON: power and reset"
                },
                "dio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "data in/out, also the host interrupt"
                },
                "cs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "chip select, active low"
                },
                "clk": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "description": "serial clock"
                },
                "mac": {
                  "type": "string",
                  "description": "MAC address, six hex bytes like 28:cd:c1:00:00:01 (default \"28:cd:c1:00:00:01\")"
                },
                "mhz": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "description": "core clock, to turn time into cycles (default: the chip's clk_sys)"
                },
                "aps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ssid": {
                        "type": "string",
                        "description": "network name, 1..32 bytes"
                      },
                      "security": {
                        "enum": ["open", "wpa2"],
                        "description": "how a station joins (default \"open\")"
                      },
                      "passphrase": {
                        "type": "string",
                        "description": "WPA2 passphrase, 8..63 characters"
                      },
                      "rssi": {
                        "type": "integer",
                        "minimum": -120,
                        "maximum": 0,
                        "description": "signal strength in dBm (default -50)"
                      },
                      "channel": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 14,
                        "description": "2.4 GHz channel (default 6)"
                      }
                    },
                    "required": ["ssid"],
                    "additionalProperties": false
                  },
                  "description": "the mock access points a scan finds (up to 8)"
                }
              },
              "required": ["on", "dio", "cs", "clk"],
              "additionalProperties": false
