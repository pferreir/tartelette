#!/usr/bin/env bash
# Cargo runner for the showcase demos: picks each demo's board from the ELF's
# name, then hands over to ../examples/run (which runs it in tartelette, or
# on a real board with TARTELETTE_RUNNER=probe-rs or picotool). A demo missing
# from the list below runs on a plain Pico, with a warning.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
elf=$1
shift
case $(basename "$elf") in
picosh)    board=(pico) ;;
lumen)     board=("$here/boards/lumen.toml") ;;
groovebox) board=("$here/boards/groovebox.toml" --drums --osc saw:dac.A:expander.bass) ;;
groovebox-audio) board=("$here/boards/groovebox-audio.toml" --shield pico-display-2) ;;
stardust)  board=(pico --shield pico-display-2) ;;
spectra)   board=("$here/boards/spectra.toml" --shield pico-display-2) ;;
varvara)
    board=("$here/boards/varvara.toml")
    # The card roms/card.sh makes, if there is one.
    if [[ -f $here/roms/card.img ]]; then
        board+=(--sd "sd=$here/roms/card.img")
    fi
    ;;
*)
    echo "showcase/run: no board for $(basename "$elf") in $0, using pico" >&2
    board=(pico)
    ;;
esac
exec "$here/../examples/run" "${board[@]}" -- "$elf" "$@"
